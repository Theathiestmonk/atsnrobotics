# SMTP configuration for contact form
# Copy this file to .env.local beside package.json, then fill in the details.
# Do not put SMTP credentials in app/.env.local or commit .env.local.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password

# Email to receive contact form submissions
CONTACT_FORM_TO=services@atsnai.com
